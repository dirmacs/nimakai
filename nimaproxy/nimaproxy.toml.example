# nimaproxy — NVIDIA NIM Key-Rotation Proxy
# ================================================================
# Copy this to nimaproxy.toml and fill in your keys.
# Then run: ./nimaproxy --config ./nimaproxy.toml
#
# All fields are optional except [[keys]] — at least one key is required.

# Local address to bind. Defaults to 127.0.0.1:8080.
# listen = "127.0.0.1:8080"

# Upstream NVIDIA NIM target. Defaults to https://integrate.api.nvidia.com.
# target = "https://integrate.api.nvidia.com"

# ── API Keys ────────────────────────────────────────────────────────────────
# Each key's RPM budget (40 RPM) pools together via round-robin rotation.
# On 429, the proxy cools down the rate-limited key and retries with the next.
# Any number of keys can be added. Keys rotate in order.

[[keys]]
key = "nvapi-YOUR_FIRST_KEY_HERE"
label = "key1"

[[keys]]
key = "nvapi-YOUR_SECOND_KEY_HERE"
label = "key2"

[[keys]]
key = "nvapi-YOUR_THIRD_KEY_HERE"
label = "key3"

[[keys]]
key = "nvapi-YOUR_FOURTH_KEY_HERE"
label = "key4"

# ── Latency-Aware Model Routing ──────────────────────────────────────────────
# When a request arrives with `"model": "auto"`, the proxy picks the best
# model from this list using real-time TTFC stats.
#
# Untried models (< 3 samples) get priority. Degraded models (≥3 consecutive
# failures or avg TTFC > spike_threshold_ms) are skipped until they recover.
#
# [routing]
# strategy           = "latency_aware"
# spike_threshold_ms = 12000
#
# models = [
#   "minimaxai/minimax-m3",
#   "z-ai/glm-5.1",
#   "stepfun-ai/step-3.7-flash",
#   "moonshotai/kimi-k2.6",
#   "qwen/qwen3.5-397b-a17b",
#   "minimaxai/minimax-m2.7",
#   "nvidia/nemotron-3-ultra-550b-a55b",
#   "deepseek-ai/deepseek-v4-flash",
# ]

# ── Model Racing (Speculative Execution) ──────────────────────────────────
# Fire N parallel requests to N models, return first response.
# Trades N×token budget for min(P50 latency).
# Server-degraded models and models where all keys failed are excluded.
# Degraded latency/failure candidates are used only as fallback capacity when
# there are not enough healthy models to fill max_parallel.
#
# [racing]
# enabled = true
# models = [
#   "minimaxai/minimax-m3",
#   "z-ai/glm-5.1",
#   "stepfun-ai/step-3.7-flash",
#   "moonshotai/kimi-k2.6",
#   "qwen/qwen3.5-397b-a17b",
#   "minimaxai/minimax-m2.7",
#   "nvidia/nemotron-3-ultra-550b-a55b",
#   "deepseek-ai/deepseek-v4-flash",
# ]
# max_parallel = 2
# timeout_ms = 15000
# max_total_request_ms = 25000
# strategy = "complete"
# adaptive = true
# min_parallel = 2
# pressure_parallel = 2
# degraded_parallel = 2
# solo_fallback = true
# large_prompt_char_threshold = 12000
# large_prompt_parallel = 1
# fast_models = [
#   "minimaxai/minimax-m3",
#   "z-ai/glm-5.1",
#   "stepfun-ai/step-3.7-flash",
# ]
# fallback_models = [
#   "moonshotai/kimi-k2.6",
#   "qwen/qwen3.5-397b-a17b",
#   "deepseek-ai/deepseek-v4-flash",
#   "minimaxai/minimax-m2.7",
#   "nvidia/nemotron-3-ultra-550b-a55b",
# ]

# ── Gateway Concurrency and Timeout Controls ─────────────────────────────────
# [limits]
# max_upstream_in_flight = 8
# max_in_flight_per_key = 2
# admission_wait_ms = 5000
#
# [logging]
# enabled = true
# path = "/var/log/nimaproxy/turns.jsonl"
#
# [timeouts]
# min_dynamic_timeout_ms = 15000
# dynamic_sample_floor = 25

# ── NVIDIA Catalog Inference Defaults ─────────────────────────────────────
# These values mirror the build.nvidia.com snippets for the current catalog
# pool. `stream=false` may be injected when omitted. `stream=true` entries are
# retained for catalog fidelity, but callers must request streaming explicitly.

[model_params."deepseek-ai/deepseek-v4-pro"]
temperature = 1.0
top_p = 0.95
max_tokens = 16384
stream = false
chat_template_kwargs = { thinking = false }

[model_params."nvidia/nemotron-3-ultra-550b-a55b"]
temperature = 1.0
top_p = 0.95
max_tokens = 16384
reasoning_budget = 16384
stream = true
chat_template_kwargs = { enable_thinking = true }

[model_params."deepseek-ai/deepseek-v4-flash"]
temperature = 1.0
top_p = 0.95
max_tokens = 16384
stream = false
chat_template_kwargs = { thinking = true, reasoning_effort = "high" }

[model_params."mistralai/mistral-medium-3.5-128b"]
temperature = 0.7
top_p = 1.0
max_tokens = 16384
stream = false
reasoning_effort = "high"

[model_params."z-ai/glm-5.1"]
temperature = 1.0
top_p = 1.0
max_tokens = 16384
stream = true
seed = 42

[model_params."stepfun-ai/step-3.7-flash"]
temperature = 1.0
top_p = 0.95
max_tokens = 16384
stream = false

[model_params."moonshotai/kimi-k2.6"]
temperature = 1.0
top_p = 1.0
max_tokens = 16384
stream = false

[model_params."qwen/qwen3.5-397b-a17b"]
temperature = 0.6
top_p = 0.95
top_k = 20
presence_penalty = 0.0
repetition_penalty = 1.0
max_tokens = 16384
stream = false

[model_params."minimaxai/minimax-m3"]
temperature = 1.0
top_p = 0.95
max_tokens = 8192
stream = false

[model_params."minimaxai/minimax-m2.7"]
temperature = 1.0
top_p = 0.95
max_tokens = 8192
stream = false
